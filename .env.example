# ============================================================================
# ENVIRONMENT CONFIGURATION - COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# ============================================================================
# WARNING: DO NOT commit .env file to git. It's listed in .gitignore
# This file (.env.example) shows what variables are needed WITHOUT exposing secrets

# ============================================================================
# MODEL CONFIGURATION
# ============================================================================
# Ollama model name for chat completion
MODEL_NAME=gemma4:e2b

# Number of GPUs available (0 for CPU-only, 1+ if you have VRAM)
NUM_GPU=1

# Number of threads for processing
NUM_THREAD=4

# ============================================================================
# SECURITY
# ============================================================================
# Admin password for the frontend (NEVER hardcode in source)
ADMIN_PASSWORD=your_secure_admin_password_here

# ============================================================================
# DATABASE
# ============================================================================
# Database path (relative or absolute)
DB_PATH=./document_db

# ============================================================================
# API KEYS & CREDENTIALS (if applicable)
# ============================================================================
# Add any API keys, credentials, or tokens here
# Examples:
# OPENAI_API_KEY=your_key_here
# AZURE_KEY=your_key_here
# DATABASE_URL=your_connection_string_here

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# Server host (default: localhost)
# SERVER_HOST=localhost

# Server port (default: 8000)
# SERVER_PORT=8000
